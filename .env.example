# Site
NEXT_PUBLIC_SITE_URL=https://fairleadadvisors.com

# Supabase — the engagement hub's project (github.com/mattfairlead/fairlead).
# /team reads its `team_members` table with the anon key; RLS only exposes
# members whose "Website" checkbox is on in the hub. Absent = the seed
# snapshot in content/seed is served. Anon key: Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://nsltkjqwvfwsknrxjvco.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SendGrid — contact form + newsletter (HubSpot is sunset). Absent = sends
# are skipped and logged, so previews work before provisioning.
SENDGRID_API_KEY=
SENDGRID_LIST_ID=
CONTACT_TO=            # info@ distribution list — create before launch (§9)
CONTACT_FROM=no-reply@fairleadadvisors.com

# Ask Fairlead — Phase 2. Trigger + API stubbed behind this flag.
NEXT_PUBLIC_ASK_ENABLED=false
ANTHROPIC_API_KEY=

# Engagement hub → content revalidation. The hub POSTs /api/revalidate with
# this secret when a team card's "Website" checkbox, bio or photo changes.
# Set the same value as WEBSITE_REVALIDATE_SECRET in the hub's env.
REVALIDATE_SECRET=
