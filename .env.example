# Site
NEXT_PUBLIC_SITE_URL=https://fairleadadvisors.com

# Dion Leadership testimonial (/engagements). Defaults to the GitHub release
# asset; point at Blob/Supabase Storage once the file moves (§9 media plan).
NEXT_PUBLIC_DION_TESTIMONIAL_URL=

# Supabase — the engagement hub's project (github.com/mattfairlead/fairlead).
# /team reads its `team_members` table with the anon key; RLS only exposes
# members whose "Website" checkbox is on in the hub. Absent = the seed
# snapshot in content/seed is served. Anon key: Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://nsltkjqwvfwsknrxjvco.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The engagement register (/engagements) reads the hub's `engagements` table
# SERVER-SIDE with the service role — that table has no anon policy, on
# purpose. Absent = the public-safe snapshot in content/seed/register.ts
# (no names, sponsors or summaries) is served and the register cannot unlock.
SUPABASE_SERVICE_ROLE_KEY=

# Engagement register access. The register is locked for everyone; a visitor
# asks to reveal it, gets an emailed link, and the link sets a signed grant
# cookie for their browser (lib/register-access.ts). ENGAGEMENTS_SECRET signs
# both tokens — any long random string (`openssl rand -base64 48`). Unset in
# production = requests are refused (fails closed). Dev derives a throwaway key.
ENGAGEMENTS_SECRET=
# verify (default) = emailed link required. instant = unlock on form submit
# (no email step; weaker — anyone can post the form). Fairlead is emailed either way.
ENGAGEMENTS_REVEAL_MODE=verify

# SendGrid — contact form, newsletter, and the register's emailed links
# (HubSpot is sunset). Absent = sends are skipped and logged (the unlock link
# is printed to the server log), so previews work before provisioning.
SENDGRID_API_KEY=
SENDGRID_LIST_ID=
CONTACT_TO=            # info@ distribution list — create before launch (§9)
CONTACT_FROM=no-reply@fairleadadvisors.com

# Ask Fairlead — Phase 2. Trigger + API stubbed behind this flag.
NEXT_PUBLIC_ASK_ENABLED=false
ANTHROPIC_API_KEY=

# Engagement hub → content revalidation. The hub POSTs /api/revalidate with
# this secret when a team card's "Website" checkbox, bio or photo changes
# (and, once wired, when an engagement summary changes — the register is
# cached under the "engagements" tag for 5 minutes otherwise).
# Set the same value as WEBSITE_REVALIDATE_SECRET in the hub's env.
REVALIDATE_SECRET=
